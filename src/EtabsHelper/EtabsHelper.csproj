<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>MoCSI</AssemblyName>
    <RootNamespace>EtabsHelper</RootNamespace>
    <NoWarn>MSB3277</NoWarn>
    <Product>MoCSI - ETABS Structural Modeling &amp; Design Suite</Product>
    <Title>MoCSI</Title>
    <Description>ETABS Structural Modeling, Analysis &amp; Design Suite for SBC 301 / SBC 304</Description>
    <Version>1.0.0</Version>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <CsiApiDll Condition="'$(CsiApiDll)' == ''">C:\Program Files\Computers and Structures\ETABS 22\CSiAPIv1.dll</CsiApiDll>
    <RevitApiDir Condition="'$(RevitApiDir)' == ''">C:\Program Files\Autodesk\Revit 2027</RevitApiDir>
  </PropertyGroup>

  <!-- CSI ETABS COM API Reference (Resolved from installed ETABS) -->
  <ItemGroup>
    <Reference Include="CSiAPIv1">
      <HintPath>$(CsiApiDll)</HintPath>
      <Private>true</Private>
      <CopyLocal>true</CopyLocal>
    </Reference>
  </ItemGroup>

  <!-- Revit 2027 API Reference (net10.0-windows only) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <Reference Include="RevitAPI" Condition="Exists('$(RevitApiDir)\RevitAPI.dll')">
      <HintPath>$(RevitApiDir)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI" Condition="Exists('$(RevitApiDir)\RevitAPIUI.dll')">
      <HintPath>$(RevitApiDir)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Exclude Revit add-in entry points for .NET 8 (ETABS) build -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-windows'">
    <Compile Remove="Revit\**" />
    <None Remove="Revit\**" />
  </ItemGroup>

</Project>
