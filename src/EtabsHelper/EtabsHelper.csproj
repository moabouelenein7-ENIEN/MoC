<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>MoC</AssemblyName>
    <RootNamespace>EtabsHelper</RootNamespace>
    <Product>MoC - ETABS Structural Modeling &amp; Design Suite</Product>
    <Title>MoC</Title>
    <Description>ETABS Structural Modeling, Analysis &amp; Design Suite for SBC 301 / SBC 304</Description>
    <Version>1.0.0</Version>
    <OutputPath>bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <CsiApiDll Condition="'$(CsiApiDll)' == ''">C:\Program Files\Computers and Structures\ETABS 22\CSiAPIv1.dll</CsiApiDll>
  </PropertyGroup>

  <!-- CSI ETABS COM API Reference (Resolved from installed ETABS) -->
  <ItemGroup>
    <Reference Include="CSiAPIv1">
      <HintPath>$(CsiApiDll)</HintPath>
      <Private>true</Private>
      <CopyLocal>true</CopyLocal>
    </Reference>
  </ItemGroup>

</Project>
